{
  "name": "Campus Drop",
  "short_name": "Campus Drop",
  "description": "A modern, secure, peer-to-peer file-sharing platform.",
  "start_url": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#090D16",
  "theme_color": "#2563EB",
  "categories": ["utilities", "productivity"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/?shared=true",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["*/*"]
        }
      ]
    }
  }
}
